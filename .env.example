# ClickUp personal API token (ClickUp -> avatar -> Settings -> Apps -> API Token). Starts with pk_
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx
# The ClickUp List ID this dashboard reads (numbers at the end of the list URL /li/<ID>)
CLICKUP_LIST_ID=901417662317

# --- Weekly Reports settings store (optional) ---------------------------
# When a pair is set, /api/settings persists the Weekly Reports module
# (schedule, configurations, channels, users) server-side, so every admin
# shares the same state. Without it the module falls back to per-browser
# localStorage and the dashboard shows a "Local settings" badge.
#
# Either naming scheme works — use whichever your provider injects:
#   Upstash directly   -> UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   Vercel Marketplace -> KV_REST_API_URL / KV_REST_API_TOKEN (added for you)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
